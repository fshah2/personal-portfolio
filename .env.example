# Copy to .env.local for local dev, and set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# Contact form (app/api/contact) — sends messages via Resend (https://resend.com).
# Required for the contact form to actually deliver mail.
RESEND_API_KEY=

# Where contact-form messages are delivered. Defaults to fdshah10@gmail.com.
CONTACT_TO_EMAIL=fdshah10@gmail.com

# Verified sender address. Without a verified domain, use Resend's onboarding
# sender (below), which can only deliver to the Resend account owner's email.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: Umami analytics (only loads in production when set).
NEXT_PUBLIC_UMAMI_ID=
